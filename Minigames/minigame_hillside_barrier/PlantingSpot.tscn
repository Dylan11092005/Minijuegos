[gd_scene format=3 uid="uid://bbm3gphmanipd"]

[sub_resource type="GDScript" id="GDScript_iil01"]
script/source = "extends Area2D
class_name HillsidePlantingSpot


# =========================================================
# CONSTANTS
# =========================================================

const SPOT_RADIUS := 38.0

const COLOR_GREEN := Color(\"#74FF7A\")
const COLOR_GREEN_SOFT := Color(\"#B7FF9C\")
const COLOR_YELLOW := Color(\"#FFE66D\")
const COLOR_WHITE := Color(\"#FFFFFF\")
const COLOR_DARK := Color(\"#2E7D32\")


# =========================================================
# PUBLIC VARIABLES
# =========================================================

@export var spot_index := 0
@export var visible_marker := true

var is_filled := false


# =========================================================
# PRIVATE VARIABLES
# =========================================================

var _time_elapsed := 0.0


# =========================================================
# LIFECYCLE METHODS
# =========================================================

func _ready():
	monitoring = true
	monitorable = true

	collision_layer = 4
	collision_mask = 2

	_ensure_collision_shape()
	queue_redraw()


func _process(delta):
	_time_elapsed += delta
	queue_redraw()


func _draw():
	if not visible_marker:
		return

	if is_filled:
		return

	var pulse := 1.0 + sin(_time_elapsed * 4.0 + spot_index) * 0.08
	var radius := SPOT_RADIUS * pulse

	# Brillo exterior suave
	draw_circle(
		Vector2.ZERO,
		radius + 10,
		Color(COLOR_GREEN.r, COLOR_GREEN.g, COLOR_GREEN.b, 0.18)
	)

	# Aro principal
	draw_arc(
		Vector2.ZERO,
		radius,
		0,
		TAU,
		80,
		COLOR_GREEN,
		5.0,
		true
	)

	# Aro interno amarillo para que parezca punto de siembra
	draw_arc(
		Vector2.ZERO,
		radius - 10,
		0,
		TAU,
		80,
		COLOR_YELLOW,
		3.0,
		true
	)

	# Centro suave
	draw_circle(
		Vector2.ZERO,
		radius - 18,
		Color(COLOR_GREEN_SOFT.r, COLOR_GREEN_SOFT.g, COLOR_GREEN_SOFT.b, 0.35)
	)

	# Pequeño brillo blanco arriba
	draw_circle(
		Vector2(-10, -12),
		5,
		Color(COLOR_WHITE.r, COLOR_WHITE.g, COLOR_WHITE.b, 0.65)
	)


# =========================================================
# PUBLIC METHODS
# =========================================================

func can_place_tree() -> bool:
	return not is_filled


func place_tree():
	is_filled = true
	monitoring = false
	visible_marker = false
	queue_redraw()


# =========================================================
# PRIVATE METHODS
# =========================================================

func _ensure_collision_shape():
	var collision_shape := get_node_or_null(\"CollisionShape2D\") as CollisionShape2D

	if collision_shape == null:
		collision_shape = CollisionShape2D.new()
		collision_shape.name = \"CollisionShape2D\"
		add_child(collision_shape)

	var circle_shape := CircleShape2D.new()
	circle_shape.radius = SPOT_RADIUS

	collision_shape.shape = circle_shape
"

[sub_resource type="CircleShape2D" id="CircleShape2D_iil01"]
radius = 45.0

